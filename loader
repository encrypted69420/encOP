            return true
        end
    end
    return false
end

local function SaveKey(key)
    pcall(function()
        if writefile then
            writefile(KEY_FILE, key .. "|" .. tostring(os.time()))
        end
    end)
end

local function DeleteSavedKey()
    pcall(function()
        if isfile and isfile(KEY_FILE) and delfile then
            delfile(KEY_FILE)
        end
    end)
end

local function GetSavedKey()
    local savedData

    pcall(function()
        if isfile and isfile(KEY_FILE) then
            savedData = readfile(KEY_FILE)
        end
    end)

    if not savedData or savedData == "" then
        return nil
    end

    local key, timestamp = savedData:match("^(.-)|(%d+)$")

    if not key or not timestamp then
        DeleteSavedKey()
        return nil
    end

    timestamp = tonumber(timestamp)

    if not timestamp then
        DeleteSavedKey()
        return nil
    end

    if os.time() - timestamp >= KEY_DURATION then
        DeleteSavedKey()
        return nil
    end

    if IsValidKey(key) then
        return key
    end

    DeleteSavedKey()
    return nil
end

local function GetRemainingTime()
    local remaining

    pcall(function()
        if isfile and isfile(KEY_FILE) then
            local data = readfile(KEY_FILE)
            local _, timestamp = data:match("^(.-)|(%d+)$")

            if timestamp then
                remaining = KEY_DURATION - (os.time() - tonumber(timestamp))
            end
        end
    end)

    return math.max(remaining or 0, 0)
end

local function FormatRemainingTime(seconds)
    local hours = math.floor(seconds / 3600)
    local minutes = math.floor((seconds % 3600) / 60)

    if hours > 0 then
        return string.format("%dh %02dm remaining", hours, minutes)
    end

    return string.format("%dm remaining", minutes)
end

local function Tween(object, duration, properties, style, direction)
    return TweenService:Create(
        object,
        TweenInfo.new(
            duration,
            style or Enum.EasingStyle.Quint,
            direction or Enum.EasingDirection.Out
        ),
        properties
    )
end

