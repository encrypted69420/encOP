task.spawn(function()
    while gui.Parent do
        local remaining = GetRemainingTime()

        if remaining > 0 then
            expiryText.Text = "Session active for " .. FormatRemainingTime(remaining)
            expiryBadge.Text = FormatRemainingTime(remaining):upper()
            expiryBadge.TextColor3 = RED_BRIGHT
        else
            expiryText.Text = "Valid for 48 hours after verification"
            expiryBadge.Text = "48 HOURS"
        end

        task.wait(30)
    end
end)

