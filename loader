verifyBtn.MouseButton1Click:Connect(function()
    Tween(verifyBtn, 0.08, {
        Size = UDim2.new(0.5, -9, 1, -4)
    }):Play()

    task.wait(0.08)

    Tween(verifyBtn, 0.12, {
        Size = UDim2.new(0.5, -5, 1, 0)
    }, Enum.EasingStyle.Back):Play()

    local enteredKey = keyBox.Text

    if IsValidKey(enteredKey) then
        SaveKey(enteredKey)

        status.Text = "ACCESS GRANTED"
        status.TextColor3 = SUCCESS

        verifyBtn.Text = "VERIFIED"
        verifyBtn.BackgroundColor3 = SUCCESS

        expiryBadge.Text = "48 HOURS"
        expiryBadge.TextColor3 = SUCCESS
        expiryBadge.BackgroundColor3 = Color3.fromRGB(8, 35, 25)

        saveInfo.Text = "Key saved locally until the 48 hour session expires"

        Tween(mainStroke, 0.35, {
            Color = SUCCESS,
            Transparency = 0.08
        }):Play()

        Tween(keyStroke, 0.35, {
            Color = SUCCESS,
            Transparency = 0.08
        }):Play()

        task.wait(0.8)

        Tween(main, 0.28, {
            Size = UDim2.new(0, 370, 0, 250),
            Position = UDim2.new(0.5, 0, 0.5, -20),
            BackgroundTransparency = 1
        }, Enum.EasingStyle.Quint, Enum.EasingDirection.In):Play()

        Tween(mainStroke, 0.2, {
            Transparency = 1
        }):Play()

        Tween(blur, 0.25, {
            Size = 0
        }):Play()

        task.wait(0.28)

        if blur.Parent then
            blur:Destroy()
        end

        if gui.Parent then
            gui:Destroy()
        end

        CreateLoadingScreen()
        ExecuteHub()
    else
        status.Text = "INVALID SECURITY KEY"
        status.TextColor3 = RED_BRIGHT

        keyBox.Text = ""

        Tween(keyStroke, 0.12, {
            Color = RED_BRIGHT
        }):Play()

        local originalPosition = keyContainer.Position

        for _ = 1, 3 do
            Tween(keyContainer, 0.055, {
                Position = originalPosition + UDim2.new(0, 6, 0, 0)
            }):Play()

            task.wait(0.055)

            Tween(keyContainer, 0.055, {
                Position = originalPosition - UDim2.new(0, 6, 0, 0)
            }):Play()

            task.wait(0.055)
        end

        Tween(keyContainer, 0.1, {
            Position = originalPosition
        }):Play()

        task.wait(1.5)

        if gui.Parent then
            status.Text = "SYSTEM READY"
            status.TextColor3 = MUTED

            Tween(keyStroke, 0.2, {
                Color = Color3.fromRGB(43, 43, 51)
            }):Play()
        end
    end
end)

